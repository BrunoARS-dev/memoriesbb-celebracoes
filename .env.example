# Porta local usada pelo Docker Compose. Ela fica acessível somente em 127.0.0.1.
APP_PORT=3000

# Caminhos para execução local sem Docker. No container, o Compose usa /data.
GALLERY_DATA_DIR=.data/gallery
GALLERY_DATABASE_PATH=.data/gallery/gallery.sqlite
GALLERY_UPLOAD_DIR=.data/gallery/uploads

# Obrigatória para acessar /gestao/galeria. Use uma senha longa e exclusiva.
GALLERY_ADMIN_PASSWORD=troque-esta-senha
